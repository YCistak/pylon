# ---- Binaries & build output ----
/pylon
/dist/
/build/
*.exe
*.dll
*.so
*.dylib
# Cross-compiled artifacts
pylon-linux-*
pylon-windows-*
pylon-darwin-*
# FUSE leaves these behind when a file is deleted while still open — which is
# what `make build` does to ./pylon. One of them (an unstripped 31 MB binary
# carrying absolute build paths) reached this repository once; never again.
.fuse_hidden*

# ---- Go ----
# Test binaries / coverage
*.test
*.out
coverage.txt
coverage.html
# Go workspace file (machine-local)
go.work
go.work.sum
# Build / module cache (only if vendored locally)
/vendor/

# ---- Runtime artifacts ----
*.sock
*.pid
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.log

# ---- Local config / secrets ----
pylon.local.yaml
*.local.yaml
# ...and the copies an editor or `cp` leaves next to them. A *.local.yaml.bak
# carries the same absolute paths and hostnames the original does, and the bare
# pattern above does not match it — one `git add -A` away from being published.
*.local.yaml.*
.env
.env.*
!.env.example
# The language picked in Settings, remembered beside the config file it
# overrides — so a daemon run from the checkout leaves it here.
/language
# Build-time OAuth client values (read by the Makefile via -include)
build.env
# Voice models (large, fetched separately)
/models/
*.bin
*.onnx

# ---- OAuth / credential tokens ----
token.json
*.token
credentials.json

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini
